{
  "name": "Nofo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "program_id": {
      "type": "string",
      "description": "FK to GrantProgram"
    },
    "program_name": {
      "type": "string"
    },
    "program_code": {
      "type": "string"
    },
    "eligibility_criteria": {
      "type": "string"
    },
    "allowable_costs": {
      "type": "string"
    },
    "evaluation_criteria": {
      "type": "string"
    },
    "total_funding_available": {
      "type": "number"
    },
    "min_award": {
      "type": "number"
    },
    "max_award": {
      "type": "number"
    },
    "open_date": {
      "type": "string",
      "format": "date"
    },
    "close_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "UnderReview",
        "Published",
        "Closed",
        "Archived"
      ]
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          }
        }
      }
    },
    "reviewed_by": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "fiscal_year": {
      "type": "number",
      "description": "Four-digit fiscal year; required when creating a new NOFO."
    },
    "federal_period_start": {
      "type": "string",
      "format": "date",
      "description": "Federal Period of Performance – Start."
    },
    "federal_period_end": {
      "type": "string",
      "format": "date",
      "description": "Federal Period of Performance – End; must be on or after the start date."
    },
    "local_share_amount": {
      "type": "number",
      "description": "Local Share (Pass-Through)."
    },
    "state_share_amount": {
      "type": "number",
      "description": "State Share (Retained)."
    },
    "mou_amount": {
      "type": "number",
      "description": "MOU Amount."
    },
    "local_share_pct": {
      "type": "number",
      "description": "Read-only local share divided by total funding, expressed as a percent."
    },
    "state_share_pct": {
      "type": "number",
      "description": "Read-only state share divided by total funding, expressed as a percent."
    },
    "legacy_grant_id": {
      "type": "string",
      "description": "Optional unique legacy Grant ID; shown only when the current Grantee has legacy fields enabled."
    }
  },
  "required": [
    "title",
    "status",
    "fiscal_year"
  ]
}
