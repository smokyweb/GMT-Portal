{
  "name": "Organization",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "County",
        "Municipality",
        "Nonprofit",
        "Tribe"
      ]
    },
    "ein": {
      "type": "string"
    },
    "sam_uei": {
      "type": "string"
    },
    "address_line_2": { "type": "string" },
    "primary_contact_user_id": { "type": "string" },
    "legacy_spars_id": { "type": "string" },
    "vendor_number": { "type": "string" },
    "duns": { "type": "string" },
    "region": { "type": "string" },
    "nonprofit_category": {
      "type": "string",
      "enum": ["Ideology-based/Spiritual/Religious", "Educational (secular)", "Medical", "Other"]
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "type"
  ]
}